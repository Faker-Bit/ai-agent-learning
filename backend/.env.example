# Agent Pilot — backend configuration
#
# Everything here is optional. The site runs with no configuration at all:
# it serves the curriculum content and the command reference.
#
# Provider keys are only used to mark a provider as "key present" in the
# Models section — the site never calls a model API.

AMT_ENV=development
AMT_DEBUG=true
AMT_HOST=127.0.0.1
AMT_PORT=8010
AMT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- paid providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# ---- free-tier providers ----
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
SILICONFLOW_API_KEY=
CLOUDFLARE_API_KEY=
CUSTOM_API_KEY=

# ---- base url overrides (shown in the site's model tables) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
